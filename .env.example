# ==============================================================================
# Inferaxis Environment Configuration Template
# ==============================================================================
# IMPORTANT: This file contains ONLY placeholder values for development setup.
# Never commit actual secrets, API keys, or production passwords to version control.
# Copy this file to '.env' and populate with your local values.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Authentication (Generate a strong 32+ char secret in production)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=inferaxis_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=inferaxis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inferaxis_user:replace_with_secure_password@localhost:5432/inferaxis_db

# Event Broker & Caching (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Configure at least one active provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Local Storage Configuration
STORAGE_PATH=./storage
DATASET_STORAGE_PATH=./storage/datasets
MAX_UPLOAD_SIZE_BYTES=52428800

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws
