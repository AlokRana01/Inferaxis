# ==============================================================================
# Inferaxis Root .gitignore
# ==============================================================================

# Python Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Python Virtual Environments
.env
.env.local
.env.*.local
.venv/
env/
venv/
ENV/

# Node & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build & Distribution Outputs
dist/
build/
out/
.next/
.turbo/
coverage/

# Security & Private Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/

# IDE & Editor files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local Databases, Uploads & Generated Datasets
*.sqlite3
*.db
storage/
dataset_storage/
data/temp/
data/uploads/
